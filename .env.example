# Discord application token
DISCORD_TOKEN=your_bot_token_here

# Optional: set a development guild ID for instant slash-command sync
GUILD_ID=

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# REQUIRED for MIH production. Supabase PostgreSQL connection string.
# Replace YOUR_DB_PASSWORD with the database password. Never commit the real password.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.qlurnngohpggpyrytlud.supabase.co:5432/postgres

# MIH Web / Discord OAuth2
DISCORD_CLIENT_ID=your_oauth2_client_id
DISCORD_CLIENT_SECRET=your_oauth2_client_secret
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
WEB_SECRET_KEY=replace_with_a_long_random_secret
WEB_COOKIE_SECURE=0
